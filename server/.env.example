# Copy this file to .env and edit values before running `docker compose up -d`.
# docker-compose.yml reads these to override Grafana defaults.

# Grafana admin credentials (change before exposing the dashboard publicly)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# 飞书告警推送
# ---------------------------------------------------------------------------
# 注意：飞书「机器人助手 / BotBuilder」的触发器地址
#   https://www.feishu.cn/flow/api/trigger-webhook/xxxxxx
# 已于 2026-06-30 下线，现在调用只会返回 HTTP 403「服务已下线」。
# 请改用「群自定义机器人」：
#   群设置 -> 群机器人 -> 添加机器人 -> 自定义机器人 -> 复制 Webhook 地址
#   地址形如 https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxx
#
# Grafana 会把告警 POST 给 feishu-relay，由它转换成飞书消息格式再转发。
FEISHU_WEBHOOK_URL=
# 多个群用逗号分隔（可选）：
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/aaa,https://open.feishu.cn/open-apis/bot/v2/hook/bbb

# 机器人开启「签名校验」时填这里（与上面 URL 按顺序对应，没有就留空占位）：
FEISHU_SIGN_SECRET=

# 机器人开启「自定义关键词」时填这里（与上面 URL 按顺序对应）：
FEISHU_KEYWORD=

# Grafana 投递目标，一般不用改
# ALERT_RELAY_URL=http://feishu-relay:8080/webhook

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
# Grafana 对外 URL（影响告警通知中的 Source/Silence 链接）
# 生产部署时改为实际服务器 IP 或域名
GF_SERVER_ROOT_URL=http://localhost:3000

# Optional: override host ports if 9090 / 3000 are already in use on the server
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
